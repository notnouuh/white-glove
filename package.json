{
  "name": "white-glove",
  "version": "1.1.0",
  "description": "Your life dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --win --x64"
  },
  "keywords": [],
  "author": "Noah",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "productName": "White Glove",
  "build": {
    "appId": "com.whiteglove.app",
    "productName": "White Glove",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "extraResources": []
  }
}